exports[`basic layouts > default slide は heading を上に、残りを順に並べる 1`] = `"<link rel="preload" as="image" href="x.png"/><main class="yd-deck"><section class="yd-slide-frame" id="s1" data-page="1" data-tags=""><div class="yd-slide"><div class="absolute inset-0 flex flex-col gap-6 px-20 py-14 b-default"><header class="flex flex-col gap-2"><div class="flex items-center gap-4 border-b-2 border-primary/30 pb-3 [&amp;_.b-heading]:text-h2"><span class="h-10 w-2 shrink-0 rounded-sm bg-accent"></span><h2 class="b-heading m-0 leading-tight font-bold text-h2"><span>H</span></h2></div></header><div class="grid min-h-0 flex-1 grid-cols-2 gap-8"><div class="flex min-h-0 min-w-0 flex-col gap-8"><div class="b-pane relative flex min-h-0 min-w-0 flex-1 flex-col" style="--pane-w:544px;--pane-h:515px;flex-grow:1;flex-basis:0"><div class="b-bullets flex flex-1 flex-col justify-center gap-5"><ul class="m-0 list-disc pl-[1.2em] marker:text-accent"><li class="my-2"><span>先</span></li><li class="my-2"><span>a</span></li><li class="my-2"><span>b</span></li></ul><blockquote class="b-quote m-0 border-l-[6px] border-primary px-6 py-2 text-muted"><div class="b-body">Q</div><cite class="mt-2 block text-small text-faint">C</cite></blockquote></div></div></div><div class="flex min-h-0 min-w-0 flex-col gap-8"><div class="b-pane relative flex min-h-0 min-w-0 flex-1 flex-col" style="--pane-w:544px;--pane-h:242px;flex-grow:1;flex-basis:0"><figure class="b-image m-0 flex min-h-0 flex-1 flex-col items-center gap-2"><img class="max-h-full" src="x.png" alt="X" style="width:400px"/><figcaption class="shrink-0 text-small text-muted"><span>cap</span></figcaption></figure></div><div class="b-pane relative flex min-h-0 min-w-0 flex-1 flex-col" style="--pane-w:544px;--pane-h:242px;flex-grow:1;flex-basis:0"><figure class="m-0 flex min-h-0 flex-1 flex-col justify-center gap-2"><pre class="b-code m-0 max-h-full min-h-0 overflow-hidden rounded-lg bg-code py-5 font-mono leading-snug text-code-ink" data-lang="ts" style="--code-cols:12;--code-rows:1;--code-chrome:40px"><code class="hljs block"><span class="block border-l-4 px-5 border-transparent"><span class="hljs-keyword">const</span> a = <span class="hljs-number">1</span>;</span></code></pre></figure></div></div></div><div class="yd-notes b-note" hidden=""><div>hidden</div></div></div><div class="yd-page-number" aria-hidden="true">1</div></div></section></main>"`;

exports[`basic layouts > header slide 1`] = `"<main class="yd-deck"><section class="yd-slide-frame" id="s1" data-page="1" data-tags="header"><div class="yd-slide"><div class="b-header absolute inset-0 flex flex-col overflow-hidden bg-linear-to-br from-primary to-primary-deep px-20 py-14 text-surface"><div aria-hidden="true" class="pointer-events-none absolute -right-40 -bottom-64 size-[640px] rounded-full bg-accent/10"></div><div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-3 bg-accent"></div><div class="relative flex flex-1 flex-col justify-center"><div class="flex flex-col gap-5 border-l-[10px] border-accent pl-8"><h1 class="m-0 text-h1 leading-[1.25] font-bold"><span>T <strong>b</strong></span></h1><p class="m-0 text-h3 leading-snug font-normal text-accent"><span>S</span></p></div></div><div class="relative flex items-end justify-between gap-6 text-small leading-snug"><div class="flex flex-col gap-1"><span class="text-h4 font-bold">A</span></div><div class="flex flex-col items-end gap-1 opacity-85"><span>D</span></div></div></div><div class="yd-page-number" aria-hidden="true">1</div></div></section></main>"`;

exports[`basic layouts > section-header slide は heading と body だけを描く 1`] = `"<main class="yd-deck"><section class="yd-slide-frame" id="s1" data-page="1" data-tags="section-header"><div class="yd-slide"><div class="b-section absolute inset-0 flex flex-col justify-center overflow-hidden bg-linear-to-br from-primary to-primary-deep px-20 py-14 text-surface [&amp;_.b-heading]:m-0 [&amp;_.b-heading]:text-[64px] [&amp;_.b-heading]:leading-tight [&amp;_.b-heading]:text-surface [&amp;_.b-body]:m-0 [&amp;_.b-body]:text-h3 [&amp;_.b-body]:text-accent"><div aria-hidden="true" class="pointer-events-none absolute -right-6 -bottom-28 text-[420px] leading-none font-extrabold text-surface/5 select-none">01</div><div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-3 bg-accent"></div><div class="relative flex flex-col gap-6"><div class="text-display leading-none font-extrabold text-accent">01</div><div class="flex flex-col gap-4 border-l-[10px] border-accent pl-8"><h2 class="b-heading m-0 leading-tight font-bold text-h2"><span>概要</span></h2><div class="b-body">本文</div></div></div></div><div class="yd-page-number" aria-hidden="true">1</div></div></section></main>"`;

exports[`basic layouts > two-column は right を右列に、それ以外を左列に置く 1`] = `"<main class="yd-deck"><section class="yd-slide-frame" id="s1" data-page="1" data-tags="two-column"><div class="yd-slide"><div class="absolute inset-0 flex flex-col gap-6 px-20 py-14 b-two-column"><header class="flex flex-col gap-2"><div class="flex items-center gap-4 border-b-2 border-primary/30 pb-3 [&amp;_.b-heading]:text-h2"><span class="h-10 w-2 shrink-0 rounded-sm bg-accent"></span><h2 class="b-heading m-0 leading-tight font-bold text-h2"><span>H</span></h2></div></header><div class="flex flex-col gap-3"><div class="b-body">L</div></div><div class="grid min-h-0 flex-1 grid-cols-2 gap-10"><div class="flex min-w-0 flex-col gap-5 [&amp;_.b-heading]:text-h3 [&amp;_.b-heading]:text-primary" style="--pane-w:540px;--pane-h:260px"></div><div class="flex min-w-0 flex-col gap-5 [&amp;_.b-heading]:text-h3 [&amp;_.b-heading]:text-primary" style="--pane-w:540px;--pane-h:260px"><div class="b-body">R</div></div></div></div><div class="yd-page-number" aria-hidden="true">1</div></div></section></main>"`;
